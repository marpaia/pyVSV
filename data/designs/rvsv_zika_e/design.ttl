ns1:rvsv_zika_e__jimmunol_2017 a sbol:Implementation ;
    sbol:built ns1:rvsv_zika_e ;
    sbol:description "Wild-type rVSV and a matrix-mutant rVSV expressing Zika envelope, or premembrane plus envelope. Vaccinated female mice conferred protection to challenged newborn mice. The full text of this paper was not available, so its genomic position is not established here." ;
    sbol:displayId "rvsv_zika_e__jimmunol_2017" ;
    sbol:hasAttachment ns1:rvsv_zika_e__jimmunol_2017_citation ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "jimmunol-2017" ;
    sbol:role <https://vsv.bio/stage/preclinical> ;
    ns1:index 0 .

