        <https://vsv.bio/timing/prophylactic> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_reactogenicity/Usage1> ;
    ns1:index 2 ;
