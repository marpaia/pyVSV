ns1:rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_antibody a sbol:TopLevel,
        prov:Activity ;
    sbol:description "Although seropositivity rates remained similarly high (48 [94%] of 51), day-28 EBOV-glycoprotein-binding and neutralising antibody titres were lower in low-dose versus high-dose vaccinees." ;
    sbol:displayId "rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_antibody" ;
    sbol:hasAttachment ns1:rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_antibody_citation ;
