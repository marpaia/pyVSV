ns1:rvsv_dg_zebov_kikwit_gp__obs_henao_restrepo_2017_efficacy a sbol:TopLevel,
        prov:Activity ;
    sbol:description "No cases of Ebola virus disease occurred 10 days or more after randomisation among randomly assigned contacts and contacts of contacts vaccinated in immediate clusters versus 16 cases (7 clusters affected) among all eligible individuals in delayed clusters." ;
    sbol:displayId "rvsv_dg_zebov_kikwit_gp__obs_henao_restrepo_2017_efficacy" ;
    sbol:hasAttachment ns1:rvsv_dg_zebov_kikwit_gp__obs_henao_restrepo_2017_efficacy_citation ;
