ns1:rvsv_dg_zebov_kikwit_gp__impl_agnandji_2016 a sbol:Implementation ;
    sbol:built ns1:rvsv_dg_zebov_kikwit_gp ;
    sbol:description "In these studies, rVSV-ZEBOV was reactogenic but immunogenic after a single dose and warrants further evaluation for safety and efficacy." ;
