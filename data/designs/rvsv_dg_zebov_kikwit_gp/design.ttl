    ns1:index 3 .

ns1:rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_reactogenicity a sbol:TopLevel,
        prov:Activity ;
    sbol:description "At 3 × 105 pfu, early-onset reactogenicity remained frequent (45 [88%] of 51 compared with 50 [98%] of 51 high dose and two [15%] of 13 placebo recipients), but mild." ;
    sbol:displayId "rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_reactogenicity" ;
    sbol:hasAttachment ns1:rvsv_dg_zebov_kikwit_gp__obs_huttner_2015_reactogenicity_citation ;
