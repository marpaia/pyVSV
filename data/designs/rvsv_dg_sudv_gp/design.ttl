ns1:rvsv_dg_sudv_gp__geisbert_2008 a sbol:Implementation ;
    sbol:built ns1:rvsv_dg_sudv_gp ;
    sbol:description "Here, we administered a VSV vector expressing the Sudan ebolavirus (SEBOV) glycoprotein to four rhesus macaques shortly after exposure to SEBOV." ;
    sbol:displayId "rvsv_dg_sudv_gp__geisbert_2008" ;
    sbol:hasAttachment ns1:rvsv_dg_sudv_gp__geisbert_2008_citation ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "geisbert-2008" ;
    sbol:role <https://vsv.bio/stage/preclinical> ;
    ns1:index 0 .

