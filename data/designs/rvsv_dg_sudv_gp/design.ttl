ns1:rvsv_dg_sudv_gp__geisbert_2008_postexposure a sbol:TopLevel,
        prov:Activity ;
    sbol:description "All four animals survived SEBOV challenge, while a control animal that received a nonspecific vector developed fulminant SEBOV hemorrhagic fever and succumbed." ;
    sbol:displayId "rvsv_dg_sudv_gp__geisbert_2008_postexposure" ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "geisbert-2008-postexposure" ;
    sbol:type <https://vsv.bio/assay/lethal-challenge>,
        <https://vsv.bio/host/nonhuman-primate>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/protection> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_dg_sudv_gp__geisbert_2008_postexposure/Usage1> ;
    ns1:challenge-dose "1,000 PFU" ;
    ns1:challenge-route "intramuscular" ;
    ns1:challenge-virus "SEBOV" ;
    ns1:index 0 .

