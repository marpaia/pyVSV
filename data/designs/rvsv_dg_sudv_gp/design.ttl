ns1:rvsv_dg_sudv_gp__geisbert_2009 a sbol:Implementation ;
    sbol:built ns1:rvsv_dg_sudv_gp ;
    sbol:description "The recombinant VSVs expressing the glycoprotein (GP) of ZEBOV (strain Mayinga) (VSVΔG/ZEBOVGP), the GP of SEBOV (strain Boniface) (VSVΔG/SEBOVGP), or the GP of MARV (strain Musoke) (VSVΔG/MARVGP) were generated using the infectious clone for the VSV Indiana serotype, as described recently (11, 15)." ;
    sbol:displayId "rvsv_dg_sudv_gp__geisbert_2009" ;
    sbol:hasAttachment ns1:rvsv_dg_sudv_gp__geisbert_2009_citation ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "geisbert-2009" ;
    sbol:role <https://vsv.bio/stage/preclinical> ;
    ns1:index 1 .

