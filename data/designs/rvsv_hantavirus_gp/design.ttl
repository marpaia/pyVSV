ns1:rvsv_hantavirus_gp__npjv_2024 a sbol:Implementation ;
    sbol:built ns1:rvsv_hantavirus_gp ;
    sbol:description "Hantaan glycoprotein replaces the VSV G open reading frame, and GFP is an additional transcription unit between that glycoprotein and L. A single dose elicited neutralizing antibody in mice." ;
