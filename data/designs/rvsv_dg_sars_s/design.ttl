ns1:rvsv_dg_sars_s__kapadia_2008_mouse_neutralization a sbol:TopLevel,
        prov:Activity ;
    sbol:description "We found that the vaccine given intramuscularly induced a neutralizing antibody response to SARS-CoV that was approximately ten-fold greater than that required for the protection from SARS-CoV infection, and significantly greater than that generated by the replication-competent vector expressing SARS-CoV S protein given by the same route." ;
    sbol:displayId "rvsv_dg_sars_s__kapadia_2008_mouse_neutralization" ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "kapadia-2008-mouse-neutralization" ;
    sbol:type <https://vsv.bio/assay/neutralization>,
        <https://vsv.bio/host/mouse>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/immunogenicity>,
        <https://vsv.bio/route/intramuscular> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_dg_sars_s__kapadia_2008_mouse_neutralization/Usage1> ;
    ns1:index 0 .

