ns1:rvsv_gl_hiv_gag__clarke_2007_mouse_neurovirulence a sbol:TopLevel,
        prov:Activity ;
    sbol:description "rVSVIN, with and without HIV gag inserted between the G and L genes, was only marginally more attenuated than wt VSV, with an LD50 of approximately 2 to 5 PFU and a slightly delayed onset of death at 2 to 5 days." ;
    sbol:displayId "rvsv_gl_hiv_gag__clarke_2007_mouse_neurovirulence" ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "clarke-2007-mouse-neurovirulence" ;
    sbol:type <https://vsv.bio/assay/safety>,
        <https://vsv.bio/host/mouse>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/safety> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_gl_hiv_gag__clarke_2007_mouse_neurovirulence/Usage1> ;
    ns1:challenge-dose "LD50 of approximately 2 to 5 PFU" ;
    ns1:challenge-route "intracranial" ;
    ns1:index 0 .

