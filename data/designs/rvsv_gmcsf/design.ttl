ns1:rvsv_gmcsf__ramsburg_2005_mouse_safety a sbol:TopLevel,
        prov:Activity ;
    sbol:description "an rVSV (VSV-GMCSF1) expressing high levels of murine granulocyte-macrophage colony-stimulating factor (GM-CSF) from the first position in the viral genome is highly attenuated in terms of viral dissemination and pathogenesis after intranasal delivery to mice." ;
    sbol:displayId "rvsv_gmcsf__ramsburg_2005_mouse_safety" ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "ramsburg-2005-mouse-safety" ;
