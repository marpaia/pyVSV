ns1:rvsv_gmcsf__ramsburg_2005_mouse_immunogenicity a sbol:TopLevel,
        prov:Activity ;
    sbol:description "this highly attenuated virus generated antibody and T-cell responses equivalent to those induced by a control virus expressing enhanced green fluorescent protein (EGFP) from the first position (VSV-EGFP1)." ;
