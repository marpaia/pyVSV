ns1:rvsv_dg_hiv_env__jvi_2005 a sbol:Implementation ;
    sbol:built ns1:rvsv_dg_hiv_env ;
    sbol:description "Because expression of HIV Env by G-deleted VSV might allow replication in human cells expressing CD4, we generated a single-cycle VSV recombinant expressing a secreted form of the HIV Env protein." ;
    sbol:displayId "rvsv_dg_hiv_env__jvi_2005" ;
    sbol:hasAttachment ns1:rvsv_dg_hiv_env__jvi_2005_citation ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "jvi-2005" ;
    sbol:role <https://vsv.bio/stage/preclinical> ;
    ns1:index 0 .

