ns1:rvsv_dg_hiv_env__jvi_2005_mouse_immunogenicity a sbol:TopLevel,
        prov:Activity ;
    sbol:description "When given by the intramuscular route in mice, we found that the single-cycle vector was equivalent to the replication-competent VSV vector in generating high-level primary and memory CD8 T-cell responses as well as antibody responses to Env." ;
    sbol:displayId "rvsv_dg_hiv_env__jvi_2005_mouse_immunogenicity" ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "jvi-2005-mouse-immunogenicity" ;
    sbol:type <https://vsv.bio/assay/immunogenicity>,
        <https://vsv.bio/host/mouse>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/immunogenicity>,
        <https://vsv.bio/route/intramuscular> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_dg_hiv_env__jvi_2005_mouse_immunogenicity/Usage1> ;
    ns1:index 0 .

