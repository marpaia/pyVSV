ns1:rvsv_dg_marv_gp__obs_garbutt_2004_animal_safety a sbol:TopLevel,
        prov:Activity ;
    sbol:description "None of the rVSV vectors, including the Marburg glycoprotein vector, displayed pathogenic potential in animals." ;
    sbol:displayId "rvsv_dg_marv_gp__obs_garbutt_2004_animal_safety" ;
    sbol:hasAttachment ns1:rvsv_dg_marv_gp__obs_garbutt_2004_animal_safety_citation ;
