    sbol:name "garbutt-2004-animal-safety" ;
    sbol:type <https://vsv.bio/assay/safety>,
        <https://vsv.bio/host/other>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/safety> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_dg_marv_gp__obs_garbutt_2004_animal_safety/Usage1> ;
    ns1:index 0 .

ns1:rvsv_dg_marv_gp__obs_nm_2005_nhp_protection a sbol:TopLevel,
        prov:Activity ;
    sbol:description "A live attenuated recombinant vaccine protected nonhuman primates against Marburg virus." ;
    sbol:displayId "rvsv_dg_marv_gp__obs_nm_2005_nhp_protection" ;
    sbol:hasAttachment ns1:rvsv_dg_marv_gp__obs_nm_2005_nhp_protection_citation ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "nm-2005-nhp-protection" ;
    sbol:type <https://vsv.bio/assay/lethal-challenge>,
        <https://vsv.bio/host/nonhuman-primate>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/protection>,
        <https://vsv.bio/route/intramuscular> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_dg_marv_gp__obs_nm_2005_nhp_protection/Usage1> ;
    ns1:challenge-virus "MARV" ;
    ns1:index 1 .

