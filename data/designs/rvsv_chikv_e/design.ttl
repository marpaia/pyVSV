ns1:rvsv_chikv_e__jvi_2013 a sbol:Implementation ;
    sbol:built ns1:rvsv_chikv_e ;
    sbol:description "The chikungunya envelope polyprotein E3-E2-6K-E1 is expressed in place of VSV G. The chimera propagates without VSV G complementation. One dose induced neutralizing antibodies and protected mice from chikungunya infection." ;
