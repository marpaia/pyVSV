ns1:rvsv_niv_n__pmid_24631094_hamster_protection a sbol:TopLevel,
        prov:Activity ;
    sbol:description "Vaccinated animals with neutralizing antibody responses were completely protected from lethal NiV disease, whereas animals vaccinated with rVSV expressing NiV N showed only partial protection." ;
    sbol:displayId "rvsv_niv_n__pmid_24631094_hamster_protection" ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "pmid-24631094-hamster-protection" ;
    sbol:type <https://vsv.bio/assay/lethal-challenge>,
        <https://vsv.bio/host/hamster>,
        <https://vsv.bio/outcome/reported>,
        <https://vsv.bio/phenotype/protection>,
        <https://vsv.bio/route/intraperitoneal> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_niv_n__pmid_24631094_hamster_protection/Usage1> ;
    ns1:challenge-dose "1000 LD50 (6.8 × 104 TCID50)" ;
    ns1:challenge-route "intraperitoneal" ;
    ns1:challenge-virus "NiV" ;
    ns1:index 0 .

