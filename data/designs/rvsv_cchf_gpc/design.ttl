ns1:rvsv_cchf_gpc__srep_2019 a sbol:Implementation ;
    sbol:built ns1:rvsv_cchf_gpc ;
    sbol:description "The recovered genome is rVSVΔG-CCHFV-GPC. VSV G was removed and the CCHFV glycoprotein precursor occupies that position. Passage produced a replication-competent vector that protected STAT1 knockout mice from challenge." ;
    sbol:displayId "rvsv_cchf_gpc__srep_2019" ;
    sbol:hasAttachment ns1:rvsv_cchf_gpc__srep_2019_citation ;
    sbol:hasNamespace <https://vsv.bio> ;
    sbol:name "srep-2019" ;
    sbol:role <https://vsv.bio/stage/preclinical> ;
    ns1:index 0 .

