        <https://vsv.bio/route/intraperitoneal> ;
    prov:qualifiedUsage <https://vsv.bio/rvsv_cchf_gpc__srep_2019_mouse_protection/Usage1> ;
    ns1:challenge-dose "50 pfu" ;
    ns1:challenge-virus "CCHFV strain Turkey2004" ;
