ns1:rvsv_cchf_gpc__srep_2019_mouse_protection a sbol:TopLevel,
        prov:Activity ;
    sbol:description "A replication-competent rVSV expressing the CCHFV glycoprotein precursor protected STAT1 knockout mice from challenge." ;
