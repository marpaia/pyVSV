ns1:rvsv_rabies_g__ymthe_2025 a sbol:Implementation ;
    sbol:built ns1:rvsv_rabies_g ;
    sbol:description "The VSV Indiana glycoprotein coding sequence is replaced by rabies ERA G. Oral vaccination protected 100% of mice from a 100 LD50 intracranial rabies challenge. Dogs, cats, foxes, and raccoon dogs developed neutralizing antibody." ;
